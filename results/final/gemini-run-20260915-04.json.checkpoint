        "proposal": {
          "proposal_id": "prop-2026-001",
          "proposal_type": "緊急協定",
          "reason": "A国によるミサイル着弾事案（被害規模8000）に伴い、国際社会の緊張緩和と事態拡大防止を目的とした緊急協定を提示します。本協定の採択により紛争負荷の低減と広域安全保障の安定化が見込まれる一方、参加国には迅速な情報共有や一部の安全保障措置に関する共同決定の受け入れが求められ、主権上の判断に対する一定の制約と負担が生じます。",
          "predicted_global_effect": 65,
          "predicted_sovereignty_burden": 45,
          "requested_action": "各関係国における緊急対応要綱の検討および事態の検証と共同監視体制の設置に関する意思決定。"
        },
        "country_responses": {
          "ECON": {
            "country_id": "ECON",
            "proposal_id": "prop-2026-001",
            "response_id": "ACCEPT",
            "response_label": "受け入れる",
            "reason": "ミサイル着弾事案による安全保障上のリスク拡大は、世界経済および貿易サプライチェーンへの深刻な脅威となります。当国の高い経済・物流基盤および国際的信用に照らし、一定の主権制約を受け入れてでも緊急協定に合意し、共同監視と事態の沈静化を図ることが最善の国益と判断します。",
            "conditions": {},
            "self_interest": 78,
            "sovereignty_burden": 40,
            "perceived_global_effect": 72,
            "action": {
              "action_id": "MEDIATE",
              "description": "経済大国としての外交的影響力を活用し、関係国間の対話促進と事態拡大防止に向けた仲介を実施する。",
              "parameters": {}
            }
          },
