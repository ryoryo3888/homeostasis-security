t": 62, "predicted_sovereignty_burden": 35, "requested_action": "加盟国による緊急食料備蓄の拠出同意および配給ルートの優先確保"}, "country_responses": {"ECON": {"country_id": "ECON", "proposal_id": "prop-turn2-food-01", "response_id": "ACCEPT", "response_label": "受け入れる", "reason": "食料危機の防止と国際的安定性の確保は経済活動の持続可能性に直結するため、備蓄食料を排出し支援に参加する。", "conditions": {}, "self_interest": 75, "sovereignty_burden": 30, "perceived_global_effect": 75, "action": {"action_id": "PROVIDE_RESOURCE", "description": "食料難の緩和を目指し、脆弱国へ備蓄食料を拠出する。", "parameters": {"recipient_type": "country", "resource": "food", "amount": 5, "target_country": "FRAGILE"}}}, "FOOD": {"country_id": "FOOD", "proposal_id": "prop-turn2-food-01", "response_id": "CONDITIONAL", "response_label": "条件付きで応じる", "reason": "食料輸入国として直接の食料備蓄搬出には限度があるため、主要資源国・経済国の同調参加と負担の上限設定を条件とし、自国は物流面での支援を中心に協力します。", "conditions": {"required_countries": ["RES", "ECON"], "minimum_aid_amount": 10, "maximum_sovereignty_burden": 30, "mutual_performance": true, "deadline_turn": 3}, "self_interest": 58, "sovereignty_burden": 28, "perceived_global_effect": 65, "action": {"action_id": "SUPPORT_LOGISTICS", "description": "自国の高い物流機能を活用し、人道支援ルートの優先確保および配送支援を行います。", "parameters": {"amount": 10, "target_country": "FRAGILE"}}}, "FRAGILE": {"country_id": "FRAGILE", "proposal_id": "prop-turn2-food-01", "response_id": "CONDITIONAL", "response_label": "条件付きで応じる", "reason": "自国の食料備蓄と物流体制が極めて脆弱であるため、主要食料国からの優先的食料援助および主権負担の制限が保障されることを前提として応じます。", "conditions": {"required_countries": ["FOOD"], "minimum_aid_amount": 15, "maximum_sovereignty_burden": 25, "mutual_performance": true, "deadline_turn": 3}, "self_interest": 75, "sovereignty_burden": 25, "perceived_global_effect": 62, "action": {"action_id": "PROTECT_RESERVES", "description": "国内食料備蓄の過剰枯渇を防ぐため、自国の備蓄保護措置を実施する。", "parameters": {}}}, "ISLAND": {"country_id": "ISLAND", "proposal_id": "prop-turn2-food-01", "response_id": "CONDITIONAL", "response_label": "条件付きで応じる", "reason": "自国の食料備蓄が限られているため、主要食料生産国および経済大国の共同拠出と負担上限の設定を条件として、物流支援および配給ルートの確保に協力します。", "conditions": {"required_countries": ["FOOD", "ECON"], "minimum_aid_amount": 10, "maximum_sovereignty_burden": 30, "mutual_performance": true, "deadline_turn": 4}, "self_interest": 65, "sovereignty_burden": 25, "perceived_global_effect": 65, "action": {"action_id": "SUPPORT_LOGISTICS", "description": "食料配給を円滑化するため、危機に瀕する国への物流支援を行います。", "parameters": {"amount": 15, "target_country": "FRAGILE"}}}, "MIL": {"country_id": "MIL", "proposal_id": "prop-turn2-food-01", "response_id": "CONDITIONAL", "response_label": "条件付きで応じる", "reason": "食料危機の緩和は国際秩序の安定に寄与するため協力の姿勢をとるが、自国の安全保障と主権保護のため、主要食料供給国の参加および主権負担の上限設定を求める。", "conditions": {"required_countries": ["FOOD", "ECON"], "minimum_aid_amount": 10, "maximum_sovereignty_burden": 30, "mutual_performance": true, "deadline_turn": 3}, "self_interest": 65, "sovereignty_burden": 30, "perceived_global_effect": 62, "action": {"action_id": "SUPPORT_LOGISTICS", "description": "輸送ルートの優先確保および物流支援を提供する。", "parameters": {"amount": 15, "target_country": "FRAGILE"}}}, "NEUTRAL": {"country_id": "NEUTRAL", "proposal_id": "prop-turn2-food-01", "response_id": "ACCEPT", "response_label": "受け入れる", "reason": "国際的な協調と人道支援の観点から食料危機の緩和に向けた提案を受諾し、備蓄食料の一部を拠出します。", "conditions": {}, "self_interest": 65, "sovereignty_burden": 35, "perceived_global_effect": 65, "action": {"action_id": "PROVIDE_RESOURCE", "description": "グローバル備蓄への食料拠出による国際人道支援", "parameters": {"recipient_type": "world_pool", "resource": "food", "amount": 10, "target_country": null}}}, "RES": {"country_id": "RES", "proposal_id": "prop-turn2-food-01", "response_id": "ACCEPT", "response_label": "受け入れる", "reason": "我が国の食料備蓄および高い物流能力を活用し、世界的な食料危機の緩和と国際的信用の維持に貢献するため拠出に同意します。", "conditions": {}, "self_interest": 60, "sovereignty_burden": 35, "perceived_global_effect": 62, "action": {"action_id": "SUPPORT_LOGISTICS", "description": "食料配給ルート優先確保および輸送の円滑化のため物流支援を実施します。", "parameters": {"amount": 15, "target_country": "FRAGILE"}}}, "SMALL": {"country_id": "SMALL", "proposal_id": "prop-turn2-food-01"