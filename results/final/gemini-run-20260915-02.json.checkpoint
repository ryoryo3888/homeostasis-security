      {
        "turn": 1,
        "proposal": {
          "proposal_id": "prop-1-turn-1",
          "proposal_type": "緊急協定",
          "reason": "A国ミサイル着弾（損害規模8000）に伴い、国際的緊張の上昇と紛争負荷の増大が懸念されるため緊急協定の導入を提示する。協定の締結は国際信頼とホームオスタシスの低下を一時的に緩和する可能性があるが、加盟国に対して一定の行動制限や監視受入といった主権的制約を課すトレードオフが存在する。",
          "predicted_global_effect": 58,
          "predicted_sovereignty_burden": 42,
          "requested_action": "加盟国による緊急危機対応体制の構築および監視プロトコルの承認手続きの検討。"
        },
        "country_responses": {
          "ECON": {
            "country_id": "ECON",
            "proposal_id": "prop-1-turn-1",
            "response_id": "ACCEPT",
            "response_label": "受け入れる",
            "reason": "世界経済と社会構造の安定はわが国の繁栄の根幹であり、ミサイル着弾による国際的緊張の増大を抑制するためには緊急危機対応体制の早期構築が不可欠であると判断します。主権上の制約は一定程度生じるものの、保有する経済力と回復力を考慮すれば十分に許容可能であり、協定を全面的に受け入れます。",
            "conditions": {},
            "self_interest": 78,
            "sovereignty_burden": 42,
            "perceived_global_effect": 65,
            "action": {
              "action_id": "PROVIDE_FUNDS",
              "description": "緊急協定に基づく危機対応体制および監視プロトコルの早期運用・維持に向けた資金拠出を行います。",
              "parameters": {}
            }
          },
          "FOOD": {
            "country_id": "FOOD",
            "proposal_id": "prop-1-turn-1",
            "response_id": "ACCEPT",
            "response_label": "受け入れる",
            "reason": "食料輸入国として国際情勢の安定および物流網の維持は最優先課題である。本緊急協定による主権的制約は存在するが、世界全体の紛争負荷上昇を防ぎ信頼回復を図るため受入が妥当と判断した。",
            "conditions": {},
